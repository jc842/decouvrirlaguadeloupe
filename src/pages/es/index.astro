---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site.config';

const esPosts = await getCollection('blog', ({ data }) => data.lang === 'es' && !data.draft);
esPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title={`${siteConfig.name} - En español`} lang="es">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <header class="mb-12 pb-8 border-b border-stone-200">
      <span class="text-xs font-bold uppercase tracking-widest text-forest-800">Edición en español</span>
      <h1 class="font-serif italic text-4xl sm:text-6xl text-stone-900 tracking-tight mt-2 mb-3">Guías de viaje y naturaleza en Guadalupe</h1>
      <p class="text-stone-600 text-base max-w-2xl leading-relaxed">
        Descubre el archipiélago del Caribe francés: selva tropical, senderos volcánicos de La Soufrière, cascadas y arrecifes de coral.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {esPosts.map(post => (
        <article class="bg-white rounded-2xl border border-stone-200/90 overflow-hidden shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between group">
          <div>
            {post.data.heroImage && (
              <a href={`/es/${post.id}/`} class="aspect-[16/10] overflow-hidden bg-stone-100 block">
                <img src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              </a>
            )}
            <div class="p-6">
              <span class="text-[10px] font-bold uppercase tracking-wider text-forest-800 bg-forest-50 px-2 py-0.5 rounded mb-2.5 inline-block">
                {post.data.category}
              </span>
              <h2 class="font-serif italic text-xl sm:text-2xl text-stone-900 group-hover:text-forest-800 transition-colors line-clamp-2 leading-snug mb-2">
                <a href={`/es/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="text-xs text-stone-600 line-clamp-3 mb-4 leading-relaxed">{post.data.description}</p>
            </div>
          </div>
          <div class="px-6 pb-5 pt-3 border-t border-stone-100 flex items-center justify-between text-[11px] text-stone-400">
            <span>{new Date(post.data.pubDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
            <span class="font-bold text-forest-800 group-hover:translate-x-0.5 transition-transform">Leer guía &rarr;</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
