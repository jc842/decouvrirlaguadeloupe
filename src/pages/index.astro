---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site.config';
import ReviveSlot from '../components/ads/ReviveSlot.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && (!data.lang || data.lang === 'fr'));
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Lead article (randonnée, nature ou cascade)
const leadPost = allPosts.find(p => p.id.includes('randonnee') || p.id.includes('site-naturel')) || allPosts[0];
const remainingPosts = allPosts.filter(p => p.id !== leadPost?.id);
const trendingPosts = remainingPosts.slice(0, 3);
const gridPosts = remainingPosts.slice(3, 12);

const hikingHighlights = allPosts.filter(p => 
  p.data.category === 'Randonnées & Nature' || 
  p.data.category === 'Sites Naturels & Plages' || 
  p.data.category === 'Activités & Nautisme'
).slice(0, 4);
---

<Layout title="Guide de Voyage & Découverte en Guadeloupe" description="Explorez les cascades tropicales, sentiers volcaniques de la Soufrière, lagons turquoise et réserves naturelles de Guadeloupe.">
  <!-- Bento Hero Section (Inspiré de Lexington Themes - Palette Tropicale Émeraude) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
      
      <!-- Carte Phare Gauche (7 colonnes) -->
      {leadPost && (
        <article class="lg:col-span-7 rounded-3xl bg-white border border-stone-200/90 p-6 sm:p-8 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow group relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-100/50 rounded-full blur-3xl pointer-events-none -mr-16 -mt-16"></div>
          
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-600 text-white shadow-sm shadow-emerald-600/20">
                {leadPost.data.category}
              </span>
              <span class="text-xs font-semibold text-stone-400">
                {new Date(leadPost.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
              </span>
            </div>

            <h1 class="text-2xl sm:text-4xl font-extrabold text-stone-900 tracking-tight leading-tight group-hover:text-emerald-700 transition-colors mb-4">
              <a href={`/blog/${leadPost.id}/`} class="focus:outline-none">
                {leadPost.data.title}
              </a>
            </h1>

            <p class="text-sm sm:text-base text-stone-600 leading-relaxed line-clamp-3 mb-6">
              {leadPost.data.description}
            </p>
          </div>

          <div class="pt-6 border-t border-stone-100 flex items-center justify-between">
            <a href={`/blog/${leadPost.id}/`} class="text-xs font-bold text-emerald-700 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1.5">
              Explorer le guide &rarr;
            </a>
            <span class="text-xs font-medium text-stone-400">
              Dossier Spécial Aventure
            </span>
          </div>
        </article>
      )}

      <!-- Colonne Droite : 3 Stories Tendances (5 colonnes) -->
      <div class="lg:col-span-5 flex flex-col gap-4 justify-between">
        <div class="flex items-center justify-between pb-2 border-b border-stone-200">
          <h2 class="text-xs font-extrabold uppercase tracking-widest text-stone-400">
            Escapades Incontournables
          </h2>
          <span class="text-xs font-semibold text-emerald-700">03 Récits</span>
        </div>

        {trendingPosts.map((post, idx) => (
          <article class="bg-white rounded-2xl border border-stone-200/90 p-5 shadow-sm hover:border-emerald-300 hover:shadow-md transition-all flex gap-4 items-start group">
            <span class="text-2xl font-black text-stone-200 group-hover:text-emerald-600 transition-colors leading-none pt-1">
              0{idx + 1}
            </span>
            <div class="flex-grow">
              <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded mb-1.5 inline-block">
                {post.data.category}
              </span>
              <h3 class="text-sm font-bold text-stone-900 group-hover:text-emerald-700 transition-colors line-clamp-2 leading-snug mb-1">
                <a href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
              </h3>
              <p class="text-xs text-stone-500 line-clamp-1">
                {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Lexington Featured Nature Callout Banner -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="rounded-3xl bg-gradient-to-br from-stone-950 via-emerald-950 to-teal-950 text-white p-8 sm:p-12 relative overflow-hidden shadow-xl border border-emerald-800/30">
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 max-w-2xl">
        <span class="inline-block text-xs font-black uppercase tracking-widest text-emerald-400 mb-3">
          Parc National & Réserves de Biosphère
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight mb-4 leading-tight">
          300 km de sentiers, cascades secrètes et lagons coralliens
        </h2>
        <p class="text-stone-300 text-sm sm:text-base leading-relaxed mb-6">
          De l'ascension mythique de la Soufrière aux eaux cristallines du Grand Cul-de-Sac Marin, découvrez les joyaux sauvages de l'archipel guadeloupéen.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/blog/" class="px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-stone-950 font-bold text-xs uppercase tracking-wider transition-colors inline-flex items-center gap-2">
            Consulter les 200 guides &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Bannière Publicitaire Header (Revive) -->
  {siteConfig.revive?.zones?.header && (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-6 flex justify-center">
      <ReviveSlot format={siteConfig.revive.zones.header.format} zoneId={siteConfig.revive.zones.header.zoneId} />
    </div>
  )}

  <!-- Highlights Nature & Randonnée -->
  {hikingHighlights.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex items-center justify-between border-b border-stone-200 pb-4 mb-6">
        <div>
          <span class="text-[11px] font-extrabold uppercase tracking-widest text-emerald-700">Dossiers Thématiques</span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-stone-900 tracking-tight">Randonnées, Nautisme & Grands Espaces</h2>
        </div>
        <a href="/blog/" class="text-xs font-bold text-emerald-700 hover:underline">
          Tout parcourir &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {hikingHighlights.map(post => (
          <article class="bg-white rounded-2xl border border-stone-200/90 p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group">
            <div>
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded mb-2 inline-block">
                {post.data.category}
              </span>
              <h3 class="text-sm font-bold text-stone-900 group-hover:text-emerald-700 transition-colors line-clamp-2 leading-snug mb-2">
                <a href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
              </h3>
              <p class="text-xs text-stone-500 line-clamp-3 mb-4 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="pt-3 border-t border-stone-100 flex items-center justify-between text-[11px] text-stone-400">
              <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}</span>
              <span class="font-bold text-emerald-700 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Grille Principale des Publications -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex items-center justify-between border-b border-stone-200 pb-4 mb-8">
      <div>
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-stone-400">Le Magazine</span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-stone-900 tracking-tight">Dernières actualités & chroniques de l'archipel</h2>
      </div>
      <a href="/blog/" class="text-xs font-bold text-stone-600 hover:text-emerald-700">
        Page Blog &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {gridPosts.map(post => (
        <article class="bg-white rounded-2xl border border-stone-200/90 p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group">
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-stone-500 bg-stone-100 px-2 py-0.5 rounded mb-2 inline-block">
              {post.data.category}
            </span>
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition-colors line-clamp-2 leading-snug mb-2">
              <a href={`/blog/${post.id}/`}>
                {post.data.title}
              </a>
            </h3>
            <p class="text-xs text-stone-600 line-clamp-3 mb-4 leading-relaxed">
              {post.data.description}
            </p>
          </div>
          <div class="pt-3 border-t border-stone-100 flex items-center justify-between text-[11px] text-stone-400">
            <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
            <span class="font-bold text-emerald-700 group-hover:translate-x-0.5 transition-transform">Lire &rarr;</span>
          </div>
        </article>
      ))}
    </div>

    <!-- Bannière In-Content -->
    {siteConfig.revive?.zones?.inContent && (
      <div class="my-10 flex justify-center">
        <ReviveSlot format={siteConfig.revive.zones.inContent.format} zoneId={siteConfig.revive.zones.inContent.zoneId} />
      </div>
    )}

    <!-- Navigation Pagination / Voir tout -->
    <div class="text-center pt-8 pb-12">
      <a href="/blog/" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-stone-900 text-white font-bold text-xs uppercase tracking-wider hover:bg-emerald-700 transition-colors">
        Explorer l'ensemble des 200 articles &rarr;
      </a>
    </div>
  </section>
</Layout>
