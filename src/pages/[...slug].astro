---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.lang || data.lang === 'fr');
  return pages.map(page => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Layout title={page.data.title} description={page.data.description} image={page.data.heroImage}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumbs -->
    <nav class="flex items-center space-x-2 text-xs font-medium text-stone-500 mb-8">
      <a href="/" class="hover:text-forest-800 transition-colors">Accueil</a>
      <span>/</span>
      <span class="text-stone-400 truncate max-w-xs sm:max-w-md">{page.data.title}</span>
    </nav>

    <header class="mb-10 pb-8 border-b border-stone-200">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-forest-900 bg-forest-50 border border-forest-200/80 mb-4">
        Guide Pratique
      </span>
      <h1 class="font-serif italic text-3xl sm:text-5xl font-medium text-stone-900 tracking-tight leading-[1.12]">
        {page.data.title}
      </h1>
      {page.data.description && (
        <p class="text-base text-stone-600 mt-4 leading-relaxed max-w-2xl">{page.data.description}</p>
      )}
    </header>

    {page.data.heroImage && (
      <div class="mb-10 rounded-2xl overflow-hidden border border-stone-200/80 shadow-xs max-w-3xl mx-auto bg-stone-100">
        <img src={page.data.heroImage} alt={page.data.title} class="w-full h-auto object-cover max-h-[500px]" loading="eager" />
      </div>
    )}

    <div class="prose prose-stone prose-headings:font-serif prose-headings:italic prose-a:text-forest-800 hover:prose-a:text-forest-900 max-w-none text-stone-700 leading-relaxed bg-white p-6 sm:p-12 rounded-3xl border border-stone-200/90 shadow-xs">
      <Content />
    </div>

    <div class="mt-12 pt-6 border-t border-stone-200 flex justify-between items-center text-xs text-stone-500">
      <a href="/" class="inline-flex items-center gap-2 font-bold text-forest-800 hover:underline">
        &larr; Retour à l'accueil
      </a>
      <span class="text-stone-400">Découvrir la Guadeloupe</span>
    </div>
  </article>
</Layout>
