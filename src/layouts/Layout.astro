---
import { siteConfig } from '../config/site.config';
import ReviveSlot from '../components/ads/ReviveSlot.astro';
import MobileStickyAd from '../components/ads/MobileStickyAd.astro';
import Matomo from '../components/analytics/Matomo.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  lang?: 'fr' | 'en' | 'es';
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = '/og-image.jpg',
  article = false,
  lang = 'fr',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);

const homeUrl = lang === 'fr' ? '/' : `/${lang}/`;
const blogUrl = lang === 'fr' ? '/blog/' : `/${lang}/blog/`;
const legalUrl = lang === 'fr' ? '/mentions-legales/' : `/${lang}/mentions-legales/`;
const privacyUrl = lang === 'fr' ? '/politique-confidentialite/' : `/${lang}/politique-confidentialite/`;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth bg-[#faf9f6] text-stone-900 antialiased selection:bg-forest-800 selection:text-white">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title === siteConfig.name ? title : `${title} | ${siteConfig.name}`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Google Fonts: Plus Jakarta Sans + Instrument Serif -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />

  <!-- Hreflang Tags for i18n SEO -->
  <link rel="alternate" hreflang="fr" href={`${siteConfig.url}/`} />
  <link rel="alternate" hreflang="en" href={`${siteConfig.url}/en/`} />
  <link rel="alternate" hreflang="es" href={`${siteConfig.url}/es/`} />
  <link rel="alternate" hreflang="x-default" href={`${siteConfig.url}/`} />

  <!-- Open Graph -->
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, siteConfig.url)} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Matomo Tag Manager (Privacy-First / Cookieless) -->
  <Matomo />
</head>

<body class="min-h-screen flex flex-col bg-[#faf9f6] text-stone-900 font-sans pb-24 md:pb-0">
  <!-- En-tête / Header Éditorial Lexington -->
  <header class="sticky top-0 z-40 bg-[#faf9f6]/95 backdrop-blur-md border-b border-stone-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <a href={homeUrl} class="flex items-center space-x-3 group">
          <span class="w-8 h-8 rounded-full bg-forest-900 text-white flex items-center justify-center font-serif text-lg italic shadow-sm">
            D
          </span>
          <div class="flex flex-col">
            <span class="font-serif italic text-2xl sm:text-3xl text-stone-900 group-hover:text-forest-800 transition-colors leading-none tracking-tight">
              {siteConfig.name}
            </span>
            <span class="text-[10px] uppercase tracking-[0.2em] font-semibold text-forest-700 mt-0.5">
              Guide Nature & Patrimoine
            </span>
          </div>
        </a>

        <!-- Navigation Desktop -->
        <nav class="hidden md:flex items-center space-x-8 text-xs font-semibold uppercase tracking-wider text-stone-700">
          <a href={homeUrl} class="hover:text-forest-800 transition-colors">{lang === 'es' ? 'Inicio' : (lang === 'en' ? 'Home' : 'Accueil')}</a>
          <a href={blogUrl} class="hover:text-forest-800 transition-colors">{lang === 'es' ? 'Guías' : (lang === 'en' ? 'Guides' : 'Le Guide')}</a>
          <a href="/blog/guide-randonnees-guadeloupe-soufriere-chutes-du-carbet/" class="hover:text-forest-800 transition-colors">Randonnées</a>
          <a href="/ou-se-trouvent-les-plus-belles-plages-de-guadeloupe/" class="hover:text-forest-800 transition-colors">Plages</a>
          <a href={legalUrl} class="hover:text-forest-800 transition-colors">{lang === 'es' ? 'Legal' : (lang === 'en' ? 'Legal' : 'Mentions Légales')}</a>
        </nav>

        <!-- Sélecteur de Langues -->
        <div class="flex items-center space-x-1.5 text-[11px] font-semibold bg-white border border-stone-200/90 rounded-full px-2.5 py-1 shadow-2xs">
          <a href="/" class={`px-2 py-0.5 rounded-full transition-colors ${lang === 'fr' ? 'bg-forest-900 text-white' : 'text-stone-600 hover:text-stone-900'}`}>FR</a>
          <span class="text-stone-300">|</span>
          <a href="/en/" class={`px-2 py-0.5 rounded-full transition-colors ${lang === 'en' ? 'bg-forest-900 text-white' : 'text-stone-600 hover:text-stone-900'}`}>EN</a>
          <span class="text-stone-300">|</span>
          <a href="/es/" class={`px-2 py-0.5 rounded-full transition-colors ${lang === 'es' ? 'bg-forest-900 text-white' : 'text-stone-600 hover:text-stone-900'}`}>ES</a>
        </div>
      </div>
    </div>
  </header>

  <!-- Leaderboard Ad Slot -->
  {siteConfig.revive?.zones?.header && (
    <div class="hidden md:flex justify-center my-4 max-w-7xl mx-auto px-4">
      <ReviveSlot format={siteConfig.revive.zones.header.format} zoneId={siteConfig.revive.zones.header.zoneId} />
    </div>
  )}

  <!-- Contenu Principal -->
  <main class="flex-grow">
    <slot />
  </main>

  <!-- Mobile Sticky Banner -->
  {siteConfig.revive?.zones?.mobileSticky && (
    <MobileStickyAd zoneId={siteConfig.revive.zones.mobileSticky.zoneId} />
  )}

  <!-- Footer Éditorial Lexington -->
  <footer class="mt-20 border-t border-stone-200/90 bg-[#f5f4ef] text-stone-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-stone-300/60">
        
        <div class="md:col-span-5">
          <span class="font-serif italic text-3xl text-stone-900 block mb-3">
            {siteConfig.name}
          </span>
          <p class="text-xs sm:text-sm text-stone-600 leading-relaxed max-w-md mb-4">
            Revue indépendante et carnet de terrain dédié à l'exploration de la Guadeloupe : sentiers de Basse-Terre, sommets volcaniques, cascades préservées, récifs marins et patrimoine antillais.
          </p>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-stone-200 text-[11px] font-semibold text-forest-800">
            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
            100% Cookieless RGPD (Dispense CNIL Matomo)
          </div>
        </div>

        <div class="md:col-span-3">
          <h3 class="text-xs font-bold uppercase tracking-wider text-stone-900 mb-4">
            Grands Dossiers
          </h3>
          <ul class="space-y-2.5 text-xs text-stone-600">
            <li><a href="/blog/guide-randonnees-guadeloupe-soufriere-chutes-du-carbet/" class="hover:text-forest-800 transition-colors">La Soufrière & Chutes du Carbet</a></li>
            <li><a href="/blog/activites-nautiques-kayak-paddle-mangrove-guadeloupe/" class="hover:text-forest-800 transition-colors">Kayak & Mangrove du Cul-de-Sac Marin</a></li>
            <li><a href="/blog/plongee-snorkeling-reserve-cousteau-recifs-guadeloupe/" class="hover:text-forest-800 transition-colors">Réserve Cousteau & Îlets Pigeon</a></li>
            <li><a href="/ou-se-trouvent-les-plus-belles-plages-de-guadeloupe/" class="hover:text-forest-800 transition-colors">Guide des Plus Belles Plages</a></li>
            <li><a href="/blog/canyonisme-randonnee-aquatique-rivieres-basse-terre/" class="hover:text-forest-800 transition-colors">Canyoning dans les Rivières</a></li>
          </ul>
        </div>

        <div class="md:col-span-4">
          <h3 class="text-xs font-bold uppercase tracking-wider text-stone-900 mb-4">
            Éthique & Démarche
          </h3>
          <p class="text-xs text-stone-600 leading-relaxed mb-4">
            Toutes nos fiches sont rédigées dans le respect des écosystèmes insulaires. Aucun traçage publicitaire intrusif n'est utilisé sur notre plateforme.
          </p>
          <div class="flex flex-wrap gap-4 text-xs font-semibold text-stone-800">
            <a href={legalUrl} class="hover:text-forest-800 transition-colors">Mentions Légales</a>
            <span>&bull;</span>
            <a href={privacyUrl} class="hover:text-forest-800 transition-colors">Politique de Confidentialité</a>
            <span>&bull;</span>
            <a href="/llms.txt" class="hover:text-forest-800 transition-colors">llms.txt</a>
          </div>
        </div>

      </div>

      <div class="pt-8 flex flex-col sm:flex-row justify-between items-center text-xs text-stone-500 gap-3">
        <p>&copy; {new Date().getFullYear()} {siteConfig.name}. Revue et carnet de terrain des îles de Guadeloupe.</p>
        <p class="text-[11px] font-semibold tracking-wider text-stone-400 uppercase">
          Édition Lexington Rainforest Editorial
        </p>
      </div>
    </div>
  </footer>

  <!-- Masquage propre des emplacements Revive sans bannière active -->
  <script is:inline>
    (function() {
      const reviveId = 'ac119b122a644588953c74c4c1daee06';
      document.addEventListener('revive-' + reviveId + '-loaded', function(e) {
        if (e && e.detail && e.detail.data && (!e.detail.data.width || Number(e.detail.data.width) === 0)) {
          const insEl = document.getElementById(e.detail.id);
          if (insEl) {
            const container = insEl.closest('.revive-slot-container') || insEl.parentElement;
            if (container) {
              container.style.display = 'none';
              const parentWrapper = container.parentElement;
              if (parentWrapper && (parentWrapper.classList.contains('flex-col') || parentWrapper.classList.contains('hidden') || parentWrapper.classList.contains('my-10') || parentWrapper.classList.contains('my-14') || parentWrapper.classList.contains('my-12')) && parentWrapper.children.length <= 2) {
                parentWrapper.style.display = 'none';
              }
            }
          }
        }
      });
    })();
  </script>
</body>
</html>
