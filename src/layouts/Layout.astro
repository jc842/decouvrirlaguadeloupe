---
import { siteConfig } from '../config/site.config';
import ReviveSlot from '../components/ads/ReviveSlot.astro';
import MobileStickyAd from '../components/ads/MobileStickyAd.astro';
import Matomo from '../components/analytics/Matomo.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  lang?: 'fr' | 'en' | 'es';
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = '/og-image.jpg',
  article = false,
  lang = 'fr',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);

// Anti-Footprint Color Schemas
const colorThemes: Record<string, { body: string; header: string; accent: string; badge: string; footer: string }> = {
  stone: {
    body: 'bg-stone-50 text-stone-800',
    header: 'bg-white/95 border-stone-200',
    accent: 'text-stone-900 hover:text-stone-600',
    badge: 'bg-stone-200 text-stone-800',
    footer: 'bg-stone-900 text-stone-300 border-stone-800',
  },
  slate: {
    body: 'bg-slate-50 text-slate-800',
    header: 'bg-white/95 border-slate-200',
    accent: 'text-blue-700 hover:text-blue-600',
    badge: 'bg-blue-100 text-blue-800',
    footer: 'bg-slate-900 text-slate-300 border-slate-800',
  },
  zinc: {
    body: 'bg-zinc-50 text-zinc-800',
    header: 'bg-white/95 border-zinc-200',
    accent: 'text-zinc-900 hover:text-zinc-600',
    badge: 'bg-zinc-200 text-zinc-800',
    footer: 'bg-zinc-950 text-zinc-300 border-zinc-900',
  },
  neutral: {
    body: 'bg-neutral-50 text-neutral-800',
    header: 'bg-white/95 border-neutral-200',
    accent: 'text-emerald-700 hover:text-emerald-600',
    badge: 'bg-emerald-100 text-emerald-800',
    footer: 'bg-neutral-950 text-neutral-300 border-neutral-900',
  }
};

const theme = colorThemes[siteConfig.theme?.colorScheme || 'stone'] || colorThemes.stone;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title === siteConfig.name ? title : `${title} | ${siteConfig.name}`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Hreflang Tags for i18n SEO -->
  <link rel="alternate" hreflang="fr" href={siteConfig.url} />
  <link rel="alternate" hreflang="en" href={`${siteConfig.url}/en`} />
  <link rel="alternate" hreflang="es" href={`${siteConfig.url}/es`} />
  <link rel="alternate" hreflang="x-default" href={siteConfig.url} />

  <!-- Open Graph -->
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, siteConfig.url)} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Matomo Tag Manager (Privacy-First / Cookieless) -->
  <Matomo />
</head>

<body class={`min-h-screen flex flex-col ${theme.body} pb-24 md:pb-0`}>
  <!-- En-tête / Header -->
  <header class={`sticky top-0 z-40 backdrop-blur-md border-b shadow-sm ${theme.header}`}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href={lang === 'fr' ? '/' : `/${lang}`} class="flex items-center space-x-2 group">
          <span class="text-xl sm:text-2xl font-black tracking-tight group-hover:opacity-80 transition-opacity">
            {siteConfig.name}
          </span>
        </a>

        <!-- Navigation Desktop -->
        <nav class="hidden md:flex items-center space-x-6 text-sm font-medium">
          <a href="/" class="hover:opacity-80 transition-opacity">{lang === 'es' ? 'Inicio' : (lang === 'en' ? 'Home' : 'Accueil')}</a>
          <a href="/blog" class="hover:opacity-80 transition-opacity">{lang === 'es' ? 'Blog' : (lang === 'en' ? 'Blog' : 'Le Blog')}</a>
          <a href="/mentions-legales" class="hover:opacity-80 transition-opacity">{lang === 'es' ? 'Aviso legal' : (lang === 'en' ? 'Legal' : 'Mentions Légales')}</a>
        </nav>

        <!-- Sélecteur de Langues -->
        <div class="hidden sm:flex items-center space-x-1.5 text-xs font-semibold bg-white/60 border rounded-full px-2.5 py-1">
          <a href="/" class={`px-1.5 py-0.5 rounded-full transition-colors ${lang === 'fr' ? 'bg-black text-white' : 'text-stone-600 hover:text-black'}`}>FR</a>
          <span class="text-stone-300">|</span>
          <a href="/en" class={`px-1.5 py-0.5 rounded-full transition-colors ${lang === 'en' ? 'bg-black text-white' : 'text-stone-600 hover:text-black'}`}>EN</a>
          <span class="text-stone-300">|</span>
          <a href="/es" class={`px-1.5 py-0.5 rounded-full transition-colors ${lang === 'es' ? 'bg-black text-white' : 'text-stone-600 hover:text-black'}`}>ES</a>
        </div>
      </div>
    </div>
  </header>

  <!-- Leaderboard Ad Slot -->
  {siteConfig.revive?.zones?.header && (
    <div class="hidden md:flex justify-center my-3">
      <ReviveSlot format={siteConfig.revive.zones.header.format} zoneId={siteConfig.revive.zones.header.zoneId} />
    </div>
  )}

  <!-- Contenu Principal -->
  <main class="flex-grow">
    <slot />
  </main>

  <!-- Mobile Sticky Banner -->
  {siteConfig.revive?.zones?.mobileSticky && (
    <MobileStickyAd zoneId={siteConfig.revive.zones.mobileSticky.zoneId} />
  )}

  <!-- Footer -->
  <footer class={`mt-16 border-t ${theme.footer}`}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs">
        <p>&copy; {new Date().getFullYear()} {siteConfig.name}. Tous droits réservés.</p>
        <div class="flex space-x-4">
          <a href="/mentions-legales" class="hover:underline">Mentions Légales</a>
          <a href="/politique-confidentialite" class="hover:underline">Confidentialité</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Matomo Tracking -->
  
</body>
</html>
